# ==============================================================================
# UniGear (College Marketplace) Environment Configuration Template
# Copy this file to .env and populate with your local or production values.
# ==============================================================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-flask-key-change-in-production

# MySQL Database Configuration
DB_NAME=college_marketplace
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_HOST=localhost
# Optional: Set DB_UNIX_SOCKET if connecting via Unix socket (e.g., /var/run/mysqld/mysqld.sock)
DB_UNIX_SOCKET=

# Cloudinary Media Storage
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Mailtrap / SMTP Email Configuration
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_USE_TLS=True
MAIL_USE_SSL=False
